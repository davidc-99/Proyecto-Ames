{
	"name": "DF_02_Integracion_Mongo",
	"properties": {
		"description": "Une a las casas limpias las colecciones garage, bsmt, pool y misc con LEFT JOIN por PID (conserva las 2.930 casas). Escribe clean/MONGO1.csv.",
		"folder": {
			"name": "ETL_Ames"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_STG_Mongo_garage",
						"type": "DatasetReference"
					},
					"name": "srcGarage",
					"description": "Staging de garage."
				},
				{
					"dataset": {
						"referenceName": "DS_STG_Mongo_bsmt",
						"type": "DatasetReference"
					},
					"name": "srcSotano",
					"description": "Staging de bsmt."
				},
				{
					"dataset": {
						"referenceName": "DS_STG_Mongo_pool",
						"type": "DatasetReference"
					},
					"name": "srcPiscina",
					"description": "Staging de pool."
				},
				{
					"dataset": {
						"referenceName": "DS_STG_Mongo_misc",
						"type": "DatasetReference"
					},
					"name": "srcMisc",
					"description": "Staging de misc."
				},
				{
					"dataset": {
						"referenceName": "DS_INT_CasasLimpias",
						"type": "DatasetReference"
					},
					"name": "srcCasasLimpias",
					"description": "Casas limpias (salida de DF_01). Universo de PID."
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_INT_CasasMongo",
						"type": "DatasetReference"
					},
					"name": "snkCasasMongo",
					"description": "Escribe clean/MONGO1.csv (un solo archivo)."
				}
			],
			"transformations": [
				{
					"name": "drvPidGarage",
					"description": "PID a texto."
				},
				{
					"name": "drvPidSotano",
					"description": "PID a texto."
				},
				{
					"name": "drvPidPiscina",
					"description": "PID a texto."
				},
				{
					"name": "drvPidMisc",
					"description": "PID a texto."
				},
				{
					"name": "joinGarage",
					"description": "LEFT JOIN por PID con garage."
				},
				{
					"name": "drvPidCasas",
					"description": "PID a texto."
				},
				{
					"name": "joinSotano",
					"description": "LEFT JOIN por PID con bsmt."
				},
				{
					"name": "joinPiscina",
					"description": "LEFT JOIN por PID con pool (solo 13 documentos)."
				},
				{
					"name": "joinMisc",
					"description": "LEFT JOIN por PID con misc."
				}
			],
			"scriptLines": [
				"source(output(",
				"          Order as short,",
				"          PID as long,",
				"          GarageType as string,",
				"          GarageYrBlt as short,",
				"          GarageFinish as string,",
				"          GarageCars as short,",
				"          GarageArea as short,",
				"          GarageQual as string,",
				"          GarageCond as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcGarage",
				"source(output(",
				"          PID as long,",
				"          BsmtQual as string,",
				"          BsmtCond as string,",
				"          BsmtExposure as string,",
				"          {BsmtFinType 1} as string,",
				"          BsmtFinSF1 as short,",
				"          BsmtFinType2 as string,",
				"          BsmtFinSF2 as short,",
				"          BsmtUnfSF as short,",
				"          TotalBsmtSF as short,",
				"          BsmtFullBath as short,",
				"          BsmtHalfBath as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcSotano",
				"source(output(",
				"          PID as long,",
				"          PoolArea as short,",
				"          PoolQC as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcPiscina",
				"source(output(",
				"          PID as integer,",
				"          MiscFeature as string,",
				"          MiscVal as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcMisc",
				"source(output(",
				"          PID as integer,",
				"          LotFrontage as double,",
				"          LotArea as integer,",
				"          Street as string,",
				"          Alley as string,",
				"          LotShape as string,",
				"          LandContour as string,",
				"          Utilities as string,",
				"          LotConfig as string,",
				"          LandSlope as string,",
				"          Neighborhood as string,",
				"          Condition1 as string,",
				"          Condition2 as string,",
				"          BldgType as string,",
				"          HouseStyle as string,",
				"          OverallQual as short,",
				"          OverallCond as short,",
				"          YearBuilt as short,",
				"          {YearRemod/Add} as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcCasasLimpias",
				"srcGarage derive(PID = toString(toLong(PID))) ~> drvPidGarage",
				"srcSotano derive(PID = toString(toLong(PID))) ~> drvPidSotano",
				"srcPiscina derive(PID = toString(toLong(PID))) ~> drvPidPiscina",
				"srcMisc derive(PID = toString(toLong(PID))) ~> drvPidMisc",
				"drvPidCasas, drvPidGarage join(drvPidCasas@PID == drvPidGarage@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinGarage",
				"srcCasasLimpias derive(PID = toString(toLong(PID))) ~> drvPidCasas",
				"joinGarage, drvPidSotano join(drvPidCasas@PID == drvPidSotano@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinSotano",
				"joinSotano, drvPidPiscina join(drvPidCasas@PID == drvPidPiscina@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinPiscina",
				"joinPiscina, drvPidMisc join(drvPidCasas@PID == drvPidMisc@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinMisc",
				"joinMisc sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['MONGO1.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> snkCasasMongo"
			]
		}
	}
}