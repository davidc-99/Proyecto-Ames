{
	"name": "DF_03_Transformacion_Neon",
	"properties": {
		"description": "Transforma amesdbtemp: Gr Liv Area = 1st + 2nd + Low Qual (regla obligatoria), Central Air true/false → Y/N, calidades y MS Zoning de id → código con Lookups. Escribe clean/neon1.csv.",
		"folder": {
			"name": "ETL_Ames"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_STG_Neon_amesdbtemp",
						"type": "DatasetReference"
					},
					"name": "srcConstruccion",
					"description": "Staging de amesdbtemp."
				},
				{
					"dataset": {
						"referenceName": "DS_STG_Neon_typequality",
						"type": "DatasetReference"
					},
					"name": "srcCalidades",
					"description": "Catálogo typequality."
				},
				{
					"dataset": {
						"referenceName": "DS_STG_Neon_mszoning",
						"type": "DatasetReference"
					},
					"name": "srcZonas",
					"description": "Catálogo mszoning."
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_INT_Neon",
						"type": "DatasetReference"
					},
					"name": "snkNeon",
					"description": "Escribe clean/neon1.csv (un solo archivo)."
				}
			],
			"transformations": [
				{
					"name": "drvGrLivAreaAire",
					"description": "REGLA: Gr Liv Area = 1st + 2nd + Low Qual. Central Air true/false → Y/N."
				},
				{
					"name": "lkpExterQual",
					"description": "Busca el id de Exter Qual en typequality."
				},
				{
					"name": "drvExterQual",
					"description": "Toma el código encontrado."
				},
				{
					"name": "selExterQual",
					"description": "Reemplaza el id por el código."
				},
				{
					"name": "lkpExterCond",
					"description": "Busca el id de Exter Cond en typequality."
				},
				{
					"name": "drvExterCond",
					"description": "Toma el código encontrado."
				},
				{
					"name": "selExterCond",
					"description": "Reemplaza el id por el código."
				},
				{
					"name": "lkpHeatingQC",
					"description": "Busca el id de Heating QC en typequality."
				},
				{
					"name": "drvHeatingQC",
					"description": "Toma el código encontrado."
				},
				{
					"name": "selHeatingQC",
					"description": "Reemplaza el id por el código."
				},
				{
					"name": "lkpKitchenQual",
					"description": "Busca el id de Kitchen Qual en typequality."
				},
				{
					"name": "drvKitchenQual",
					"description": "Toma el código encontrado."
				},
				{
					"name": "selKitchenQual",
					"description": "Reemplaza el id por el código."
				},
				{
					"name": "lkpMSZoning",
					"description": "Busca el id de MS Zoning en mszoning."
				},
				{
					"name": "drvMSZoning",
					"description": "Toma el código de zona encontrado."
				},
				{
					"name": "selCatZonas",
					"description": "Renombra el código de zona para el Lookup."
				},
				{
					"name": "selConstruccionFinal",
					"description": "Columnas finales de construcción."
				}
			],
			"scriptLines": [
				"source(output(",
				"          ExterCond as string,",
				"          ExterQual as string,",
				"          {Heating QC} as string,",
				"          KitchenQual as string,",
				"          MSZoning as string,",
				"          Pid as integer,",
				"          RoofStyle as string,",
				"          RoofMatl as string,",
				"          Exterior1st as string,",
				"          Exterior2nd as string,",
				"          MasVnrType as string,",
				"          MasVnrArea as short,",
				"          Foundation as string,",
				"          Heating as string,",
				"          {Central Air} as string,",
				"          lectrical as string,",
				"          {1stFlrSF} as short,",
				"          {2ndFlrSF} as short,",
				"          LowQualFinSF as short,",
				"          {Kitchen AbvGr} as short,",
				"          TotRmsAbvGrd as short,",
				"          Functional as string,",
				"          Fireplaces as short,",
				"          FireplaceQu as string,",
				"          PavedDrive as string,",
				"          WoodDeckSF as short,",
				"          OpenPorchSF as short,",
				"          EnclosedPorch as short,",
				"          {3SsnPorch} as short,",
				"          ScreenPorch as short,",
				"          Fence as string,",
				"          MSSubClass as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcConstruccion",
				"source(output(",
				"          Id as string,",
				"          Code as string,",
				"          Description as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcCalidades",
				"source(output(",
				"          Id as string,",
				"          Description as string,",
				"          MSZoning as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcZonas",
				"srcConstruccion derive(PID = toString(toLong(Pid)),",
				"          {1stFlrSF} = toInteger(coalesce({1stFlrSF}, 0)),",
				"          {2ndFlrSF} = toInteger(coalesce({2ndFlrSF}, 0)),",
				"          LowQualFinSF = toInteger(coalesce(LowQualFinSF, 0)),",
				"          GrLivArea = toInteger(coalesce({1stFlrSF}, 0)) + toInteger(coalesce({2ndFlrSF}, 0)) + toInteger(coalesce(LowQualFinSF, 0)),",
				"          {Central Air} = iif(lower(toString({Central Air})) == 'true', 'Y', 'N')) ~> drvGrLivAreaAire",
				"drvGrLivAreaAire, srcCalidades lookup(ExterQual == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpExterQual",
				"lkpExterQual derive(ExterQual_txt = toString(Code)) ~> drvExterQual",
				"drvExterQual select(mapColumn(",
				"          ExterCond,",
				"          HeatingQC = {Heating QC},",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = srcConstruccion@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir = {Central Air},",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr = {Kitchen AbvGr},",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = drvGrLivAreaAire@PID,",
				"          GrLivArea,",
				"          ExterQual = ExterQual_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selExterQual",
				"selExterQual, srcCalidades lookup(ExterCond == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpExterCond",
				"lkpExterCond derive(ExterCond_txt = toString(Code)) ~> drvExterCond",
				"drvExterCond select(mapColumn(",
				"          HeatingQC,",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = selExterQual@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = selExterQual@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond = ExterCond_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selExterCond",
				"selExterCond, srcCalidades lookup(HeatingQC == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpHeatingQC",
				"lkpHeatingQC derive(HeatingQC_txt = toString(Code)) ~> drvHeatingQC",
				"drvHeatingQC select(mapColumn(",
				"          KitchenQual,",
				"          MSZoning,",
				"          Pid = selExterCond@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = selExterCond@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC = HeatingQC_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selHeatingQC",
				"selHeatingQC, srcCalidades lookup(KitchenQual == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpKitchenQual",
				"lkpKitchenQual derive(KitchenQual_txt = toString(Code)) ~> drvKitchenQual",
				"drvKitchenQual select(mapColumn(",
				"          MSZoning,",
				"          Pid = selHeatingQC@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = selHeatingQC@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC,",
				"          KitchenQual = KitchenQual_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selKitchenQual",
				"selKitchenQual, selCatZonas lookup(MSZoning == Id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpMSZoning",
				"lkpMSZoning derive(MSZoning_txt = ZoneCode) ~> drvMSZoning",
				"srcZonas select(mapColumn(",
				"          Id,",
				"          Description,",
				"          ZoneCode = MSZoning",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selCatZonas",
				"drvMSZoning select(mapColumn(",
				"          Pid = selKitchenQual@Pid,",
				"          RoofStyle,",
				"          RoofMatl,",
				"          Exterior1st,",
				"          Exterior2nd,",
				"          MasVnrType,",
				"          MasVnrArea,",
				"          Foundation,",
				"          Heating,",
				"          CentralAir,",
				"          lectrical,",
				"          {1stFlrSF},",
				"          {2ndFlrSF},",
				"          LowQualFinSF,",
				"          KitchenAbvGr,",
				"          TotRmsAbvGrd,",
				"          Functional,",
				"          Fireplaces,",
				"          FireplaceQu,",
				"          PavedDrive,",
				"          WoodDeckSF,",
				"          OpenPorchSF,",
				"          EnclosedPorch,",
				"          {3SsnPorch},",
				"          ScreenPorch,",
				"          Fence,",
				"          MSSubClass,",
				"          PID = selKitchenQual@PID,",
				"          GrLivArea,",
				"          ExterQual,",
				"          ExterCond,",
				"          HeatingQC,",
				"          KitchenQual,",
				"          MSZoning = MSZoning_txt",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selConstruccionFinal",
				"selConstruccionFinal sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['neon1.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> snkNeon"
			]
		}
	}
}