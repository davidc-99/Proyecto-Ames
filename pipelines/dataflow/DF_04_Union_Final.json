{
	"name": "DF_04_Union_Final",
	"properties": {
		"description": "Une casas+Mongo con Neon, FloorDetail sumado por PID y la venta (mes y año). Rellena NA/0, ordena las 81 columnas en camelCase y escribe output/salida.csv.",
		"folder": {
			"name": "ETL_Ames"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_INT_CasasMongo",
						"type": "DatasetReference"
					},
					"name": "srcCasasMongo",
					"description": "Casas + MongoDB (salida de DF_02). Lado izquierdo de todas las uniones."
				},
				{
					"dataset": {
						"referenceName": "DS_INT_Neon",
						"type": "DatasetReference"
					},
					"name": "srcNeon",
					"description": "Construcción transformada (salida de DF_03)."
				},
				{
					"dataset": {
						"referenceName": "DS_STG_Neon_saleproperty",
						"type": "DatasetReference"
					},
					"name": "srcVentas",
					"description": "Staging de saleproperty."
				},
				{
					"dataset": {
						"referenceName": "DS_STG_Neon_floordetail",
						"type": "DatasetReference"
					},
					"name": "srcPisos",
					"description": "Staging de floordetail."
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_OUT_Salida",
						"type": "DatasetReference"
					},
					"name": "snkSalida",
					"description": "Escribe output/salida.csv (un solo archivo)."
				}
			],
			"transformations": [
				{
					"name": "selSinDuplicados",
					"description": "Quita columnas repetidas tras las uniones."
				},
				{
					"name": "drvFaltantesNAyCero",
					"description": "REGLA: texto vacío → NA, número vacío → 0 (incluye MongoDB)."
				},
				{
					"name": "drvMesAnioVenta",
					"description": "REGLA: mes y año de Sale Date. PID a texto."
				},
				{
					"name": "joinNeon",
					"description": "LEFT JOIN por PID con la construcción."
				},
				{
					"name": "joinPisos",
					"description": "LEFT JOIN por PID con habitaciones y baños sumados."
				},
				{
					"name": "joinVentas",
					"description": "LEFT JOIN por PID con la venta."
				},
				{
					"name": "drvPidPisos",
					"description": "PID a texto."
				},
				{
					"name": "aggPisosPorCasa",
					"description": "REGLA: suma habitaciones y baños por PID (de 4.182 filas a 2.930) antes de unir."
				},
				{
					"name": "selEsquemaSalida",
					"description": "81 columnas en camelCase y en el orden del enunciado."
				}
			],
			"scriptLines": [
				"source(output(",
				"          PID as string,",
				"          LotFrontage as double,",
				"          LotArea as integer,",
				"          Street as string,",
				"          Alley as string,",
				"          LotShape as string,",
				"          LandContour as string,",
				"          Utilities as string,",
				"          LotConfig as string,",
				"          LandSlope as string,",
				"          Neighborhood as string,",
				"          Condition1 as string,",
				"          Condition2 as string,",
				"          BldgType as string,",
				"          HouseStyle as string,",
				"          OverallQual as short,",
				"          OverallCond as short,",
				"          YearBuilt as short,",
				"          {YearRemod/Add} as short,",
				"          GarageType as string,",
				"          GarageYrBlt as short,",
				"          GarageFinish as string,",
				"          GarageCars as short,",
				"          GarageArea as short,",
				"          GarageQual as string,",
				"          GarageCond as string,",
				"          BsmtQual as string,",
				"          BsmtCond as string,",
				"          BsmtExposure as string,",
				"          {BsmtFinType 1} as string,",
				"          BsmtFinSF1 as short,",
				"          BsmtFinType2 as string,",
				"          BsmtFinSF2 as short,",
				"          BsmtUnfSF as short,",
				"          TotalBsmtSF as short,",
				"          BsmtFullBath as short,",
				"          BsmtHalfBath as short,",
				"          PoolArea as short,",
				"          PoolQC as string,",
				"          MiscFeature as string,",
				"          MiscVal as short,",
				"          Order as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcCasasMongo",
				"source(output(",
				"          Pid as string,",
				"          RoofStyle as string,",
				"          RoofMatl as string,",
				"          Exterior1st as string,",
				"          Exterior2nd as string,",
				"          MasVnrType as string,",
				"          MasVnrArea as short,",
				"          Foundation as string,",
				"          Heating as string,",
				"          CentralAir as string,",
				"          lectrical as string,",
				"          {1stFlrSF} as short,",
				"          {2ndFlrSF} as short,",
				"          LowQualFinSF as short,",
				"          KitchenAbvGr as short,",
				"          TotRmsAbvGrd as short,",
				"          Functional as string,",
				"          Fireplaces as short,",
				"          FireplaceQu as string,",
				"          PavedDrive as string,",
				"          WoodDeckSF as short,",
				"          OpenPorchSF as short,",
				"          EnclosedPorch as short,",
				"          {3SsnPorch} as short,",
				"          ScreenPorch as short,",
				"          Fence as string,",
				"          MSSubClass as short,",
				"          PID as string,",
				"          GrLivArea as short,",
				"          ExterQual as string,",
				"          ExterCond as string,",
				"          HeatingQC as string,",
				"          KitchenQual as string,",
				"          MSZoning as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcNeon",
				"source(output(",
				"          PID as string,",
				"          SaleDate as string,",
				"          SaleType as string,",
				"          SaleCondition as string,",
				"          salePrice as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcVentas",
				"source(output(",
				"          PID as integer,",
				"          Floor as boolean,",
				"          Bedrooms as short,",
				"          FullBath as short,",
				"          HalfBath as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcPisos",
				"joinVentas select(skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selSinDuplicados",
				"selSinDuplicados derive(each(match(in(['GarageType','GarageFinish','GarageQual','GarageCond','BsmtQual','BsmtCond','BsmtExposure','BsmtFinType 1','BsmtFinType2','PoolQC','MiscFeature'],name)), $$ = iif(isNull($$) || trim(toString($$)) == '', 'NA', trim(toString($$)))),",
				"          each(match(in(['GarageYrBlt','GarageCars','GarageArea','BsmtFinSF1','BsmtFinSF2','BsmtUnfSF','TotalBsmtSF','BsmtFullBath','BsmtHalfBath','PoolArea','MiscVal'],name)), $$ = iif(isNull($$) || trim(toString($$)) == '', '0', trim(toString($$)))),",
				"          each(match(in(['RoofStyle','RoofMatl','Exterior1st','Exterior2nd','MasVnrType','Foundation','Heating','CentralAir','Electrical','Functional','FireplaceQu','PavedDrive','Fence','ExterQual','ExterCond','HeatingQC','KitchenQual','MSZoning','SaleType','SaleCondition'],name)), $$ = iif(isNull($$) || trim(toString($$)) == '', 'NA', trim(toString($$)))),",
				"          each(match(in(['MSSubClass','MasVnrArea','1stFlrSF','2ndFlrSF','LowQualFinSF','GrLivArea','KitchenAbvGr','TotRmsAbvGrd','Fireplaces','WoodDeckSF','OpenPorchSF','EnclosedPorch','3SsnPorch','ScreenPorch','Bedrooms','FullBath','HalfBath','MoSold','YrSold','salePrice'],name)), $$ = iif(isNull($$) || trim(toString($$)) == '', '0', trim(toString($$))))) ~> drvFaltantesNAyCero",
				"srcVentas derive(PID = toString(toLong(PID)),",
				"          MoSold = month(coalesce(toDate(left(trim(SaleDate), 10), 'yyyy-MM-dd'), toDate(trim(SaleDate), 'M/d/yyyy h:mm:ss a'))),",
				"          YrSold = year(coalesce(toDate(left(trim(SaleDate), 10), 'yyyy-MM-dd'), toDate(trim(SaleDate), 'M/d/yyyy h:mm:ss a')))) ~> drvMesAnioVenta",
				"srcCasasMongo, srcNeon join(srcCasasMongo@PID == srcNeon@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinNeon",
				"joinNeon, aggPisosPorCasa join(srcCasasMongo@PID == aggPisosPorCasa@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinPisos",
				"joinPisos, drvMesAnioVenta join(srcCasasMongo@PID == drvMesAnioVenta@PID,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> joinVentas",
				"srcPisos derive(PID = toString(toLong(PID))) ~> drvPidPisos",
				"drvPidPisos aggregate(groupBy(PID),",
				"     Bedrooms = sum(toInteger(Bedrooms)),",
				"          FullBath = sum(toInteger(FullBath)),",
				"          HalfBath = sum(toInteger(HalfBath))) ~> aggPisosPorCasa",
				"drvFaltantesNAyCero select(mapColumn(",
				"          PID = selSinDuplicados@PID,",
				"          MSSubClass,",
				"          MSZoning,",
				"          lotFrontage = LotFrontage,",
				"          lotArea = LotArea,",
				"          street = Street,",
				"          alley = Alley,",
				"          lotShape = LotShape,",
				"          landContour = LandContour,",
				"          utilities = Utilities,",
				"          lotConfig = LotConfig,",
				"          landSlope = LandSlope,",
				"          neighborhood = Neighborhood,",
				"          condition1 = Condition1,",
				"          condition2 = Condition2,",
				"          bldgType = BldgType,",
				"          houseStyle = HouseStyle,",
				"          overallQual = OverallQual,",
				"          overallCond = OverallCond,",
				"          yearBuilt = YearBuilt,",
				"          yearRemodAdd = {YearRemod/Add},",
				"          roofStyle = RoofStyle,",
				"          roofMatl = RoofMatl,",
				"          exterior1st = Exterior1st,",
				"          exterior2nd = Exterior2nd,",
				"          masVnrType = MasVnrType,",
				"          masVnrArea = MasVnrArea,",
				"          exterQual = ExterQual,",
				"          exterCond = ExterCond,",
				"          foundation = Foundation,",
				"          bsmtQual = BsmtQual,",
				"          bsmtCond = BsmtCond,",
				"          bsmtExposure = BsmtExposure,",
				"          bsmtFinType1 = {BsmtFinType 1},",
				"          bsmtFinSf1 = BsmtFinSF1,",
				"          bsmtFinType2 = BsmtFinType2,",
				"          bsmtFinSf2 = BsmtFinSF2,",
				"          bsmtUnfSf = BsmtUnfSF,",
				"          totalBsmtSf = TotalBsmtSF,",
				"          heating = Heating,",
				"          heatingQC = HeatingQC,",
				"          centralAir = CentralAir,",
				"          electrical = lectrical,",
				"          {1stFlrSf} = {1stFlrSF},",
				"          {2ndFlrSf} = {2ndFlrSF},",
				"          lowQualFinSf = LowQualFinSF,",
				"          grLivArea = GrLivArea,",
				"          bsmtFullBath = BsmtFullBath,",
				"          bsmtHalfBath = BsmtHalfBath,",
				"          fullBath = FullBath,",
				"          halfBath = HalfBath,",
				"          bedroom = Bedrooms,",
				"          kitchenAbvGr = KitchenAbvGr,",
				"          kitchenQual = KitchenQual,",
				"          totRmsAbvGrd = TotRmsAbvGrd,",
				"          functional = Functional,",
				"          fireplaces = Fireplaces,",
				"          fireplaceQu = FireplaceQu,",
				"          garageType = GarageType,",
				"          garageYrBlt = GarageYrBlt,",
				"          garageFinish = GarageFinish,",
				"          garageCars = GarageCars,",
				"          garageArea = GarageArea,",
				"          garageQual = GarageQual,",
				"          garageCond = GarageCond,",
				"          pavedDrive = PavedDrive,",
				"          woodDeckSf = WoodDeckSF,",
				"          openPorchSf = OpenPorchSF,",
				"          enclosedPorch = EnclosedPorch,",
				"          {3ssnPorch} = {3SsnPorch},",
				"          screenPorch = ScreenPorch,",
				"          poolArea = PoolArea,",
				"          poolQC = PoolQC,",
				"          fence = Fence,",
				"          miscFeature = MiscFeature,",
				"          miscVal = MiscVal,",
				"          moSold = MoSold,",
				"          yrSold = YrSold,",
				"          saleType = SaleType,",
				"          saleCondition = SaleCondition,",
				"          salePrice",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selEsquemaSalida",
				"selEsquemaSalida sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['salida.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> snkSalida"
			]
		}
	}
}