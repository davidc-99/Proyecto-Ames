{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ames-etlinmo-corregido"
		},
		"LS_Blob_Ames_connectionString": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"connectionString\"de \"LS_Blob_Ames\""
		},
		"LS_Mongo_Atlas_connectionString": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"connectionString\"de \"LS_Mongo_Atlas\""
		},
		"LS_Neon_AmesDB_connectionString": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"connectionString\"de \"LS_Neon_AmesDB\""
		},
		"LS_Mongo_Atlas_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "test"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/LS_Blob_Ames')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Conexión a Azure Blob Storage (contenedor 'sources'): entrada, staging, intermedios y salida.",
				"annotations": [
					"proyecto-ames"
				],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('LS_Blob_Ames_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_Mongo_Atlas')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Conexión a MongoDB Atlas (base 'test'): colecciones garage, bsmt, pool y misc.",
				"annotations": [
					"proyecto-ames"
				],
				"type": "MongoDbAtlas",
				"typeProperties": {
					"connectionString": "[parameters('LS_Mongo_Atlas_connectionString')]",
					"database": "[parameters('LS_Mongo_Atlas_properties_typeProperties_database')]",
					"driverVersion": "v2"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_Neon_AmesDB')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Conexión a la base relacional AmesDB en Neon (PostgreSQL).",
				"annotations": [
					"proyecto-ames"
				],
				"type": "AzurePostgreSql",
				"version": "1.0",
				"typeProperties": {
					"connectionString": "[parameters('LS_Neon_AmesDB_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_INT_CasasLimpias')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "INTERMEDIO · clean/casas_limpias.csv: CSV de propiedades ya limpio (salida de DF_01).",
				"linkedServiceName": {
					"referenceName": "LS_Blob_Ames",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "03_Intermedios"
				},
				"annotations": [
					"proyecto-ames"
				],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "casas_limpias.csv",
						"folderPath": "clean",
						"container": "sources"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_Blob_Ames')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_INT_CasasMongo')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "INTERMEDIO · clean/MONGO1.csv: casas + garage, bsmt, pool y misc (salida de DF_02).",
