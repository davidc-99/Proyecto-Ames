					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_Blob_Ames')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_OUT_Salida')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "SALIDA · output/salida.csv: 2.930 filas × 81 columnas en camelCase, separador ; (salida de DF_04).",
