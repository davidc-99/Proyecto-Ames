					"referenceName": "LS_Blob_Ames",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "03_Intermedios"
				},
				"annotations": [
					"proyecto-ames"
				],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": "MONGO1.csv",
						"folderPath": "clean",
						"container": "sources"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_Blob_Ames')]"
			]
		},
